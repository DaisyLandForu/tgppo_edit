+    def getNumLPBranchCands(self):
+        """Get the number of branching candidates from the LP relaxation."""
+        cdef SCIP_VAR** lpcands
+        cdef SCIP_Real* lpcandssol
+        cdef SCIP_Real* lpcandsfrac
+        cdef int nlpcands
+        cdef int npriolpcands
