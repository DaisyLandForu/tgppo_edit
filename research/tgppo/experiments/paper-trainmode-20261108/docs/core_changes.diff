+        inputs, before = probe
+        previous_mode = self.actor_network.training
+        try:
+            self.actor_network.eval()
+            after = self.actor_network(*inputs)
+        finally:
+            self.actor_network.train(previous_mode)
+        mask = inputs[-1]
+        count = (~mask).sum(1)
+        uniform = (~mask).to(after.dtype) / count[:, None]
